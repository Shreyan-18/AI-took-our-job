{
  "form": "Panihati_Signboard_Clearance_Form.pdf",
  "licence_id": "lic_wb_signage",
  "coord_origin": "top-left",
  "fields": [
    {
      "target": {
        "acroform": "applicant_name"
      },
      "source": "applicant_profile.applicant.name",
      "mandatory": true,
      "transform": "title"
    },
    {
      "target": {
        "acroform": "shop_name"
      },
      "source": "applicant_profile.entity_name",
      "mandatory": true,
      "transform": "upper"
    },
    {
      "target": {
        "acroform": "premises_address"
      },
      "source": "applicant_profile.location.address",
      "mandatory": true
    },
    {
      "target": {
        "acroform": "floor_area"
      },
      "source": "applicant_profile.domain_attributes.floor_area_sqft",
      "mandatory": true
    },
    {
      "target": {
        "acroform": "mobile_number"
      },
      "source": "applicant_profile.applicant.phone",
      "mandatory": true,
      "transform": "phone_10digit"
    }
  ]
}