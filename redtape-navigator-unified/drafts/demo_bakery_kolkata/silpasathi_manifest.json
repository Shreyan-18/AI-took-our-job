{
  "portal_name": "SilpaSathi West Bengal Shops & Establishments (Form B)",
  "licence_id": "lic_wb_shops_and_establishments",
  "portal_url": "https://silpasathi.wb.gov.in/",
  "stop_before_gates": [
    "SilpaSathi Login & Mobile OTP",
    "Statutory registration fee calculation & payment",
    "Final declaration & Submit"
  ],
  "actions": [
    {
      "action": "fill",
      "label": "Name of Establishment",
      "selector": "#estName",
      "source": "applicant_profile.entity_name",
      "value_masked": false,
      "value": "SUNRISE BAKERY"
    },
    {
      "action": "fill",
      "label": "Category of Establishment",
      "selector": "#estCategory",
      "source": "applicant_profile.activity_type",
      "value_masked": false,
      "value": "Bakery"
    },
    {
      "action": "fill",
      "label": "District / Municipality",
      "selector": "#estDistrict",
      "source": "applicant_profile.location.city_or_village",
      "value_masked": false,
      "value": "Kolkata"
    },
    {
      "action": "fill",
      "label": "Number of Workers on Site",
      "selector": "#workerCount",
      "source": "applicant_profile.domain_attributes.workers_on_site",
      "value_masked": false,
      "value": "3"
    },
    {
      "action": "fill",
      "label": "Employer Full Name",
      "selector": "#empName",
      "source": "applicant_profile.applicant.name",
      "value_masked": false,
      "value": "Aarav Sen"
    },
    {
      "action": "fill",
      "label": "Employer Mobile Number",
      "selector": "#empMobile",
      "source": "applicant_profile.applicant.phone",
      "value_masked": false,
      "value": "9830012345"
    }
  ],
  "missing_fields": [
    "applicant_profile.location.address"
  ],
  "completion_percentage": 86
}